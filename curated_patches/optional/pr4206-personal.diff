+    def test_qwen4_yarn_target_rides_max_context_window(
+        self, pool_with_mock_engines
+    ):
+        """On Qwen4-Exp the context-window override above the native horizon
+        IS the rope target: crossing a YaRN rung must split the engine, and
+        two requests inside one rung serve a bit-identical rope so they must
+        not. Below native — and on every other model type — the override is
+        gate-only and must not split either."""
+        from omlx.model_settings import ModelSettings
