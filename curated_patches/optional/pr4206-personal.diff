+def test_nax_packed_prefill_kill_switch_retires_the_arm_without_breaking_attention(
+    monkeypatch,
+):
+    """OMLX_QWEN4_QSA_NAX_TQ=0 drops the fused arm, and attention survives.
+
+    Shipping a fused tensor-unit kernel that reads the packed bitstream needs a
+    way back to the compiled arm without reverting a build. The switch is read
+    per call, so off must mean: the capability probe says no, the arm returns
+    None so the caller falls through, and the kernel is never invoked. The
+    output must still land in the same place as the fused arm's, because both
+    consume identical packed state and identical block selections.
+    """
+    from mlx_vlm.models.qwen4_exp import qsa_fast as F
+    from mlx_vlm.models.qwen4_exp import qsa_nax
+
+    heads, kv_heads, dim, idx_dim, ratio, tokens, queries = 24, 2, 256, 128, 4, 2048, 32
+
+    def ident(x):
+        return x
+
+    def ident_rope(x, positions):
+        return x
+
+    rng = _rng(4142)
+    keys = mx.array(rng.standard_normal((1, kv_heads, tokens, dim)).astype(np.float32))
+    values = mx.array(rng.standard_normal((1, kv_heads, tokens, dim)).astype(np.float32))
+    dense = QSAKVCache()
+    dense.update_and_fetch(keys, values)
+    ik = mx.array(rng.standard_normal((1, tokens, idx_dim)).astype(np.float32))
+    ip = mx.arange(tokens, dtype=mx.int32)[None, :]
+    dense.update_indexer(ik, ip)
+    hybrid = TurboQuantQSAKVCache.from_qsa_cache(dense, bits=6)
+    iq = mx.array(rng.standard_normal((1, queries, 2, idx_dim)).astype(np.float32))
+    qs = mx.array(
+        rng.standard_normal((1, heads, queries, dim)).astype(np.float32)
+    ).astype(mx.bfloat16)
+    kwargs = {
+        "num_query_heads": heads,
+        "num_key_value_heads": kv_heads,
+        "head_dim": dim,
+        "indexer_head_dim": idx_dim,
+        "compress_ratio": ratio,
+        "token_budget": 2048,
+        "index_key_norm": ident,
+        "apply_index_rope": ident_rope,
+        "pooled_index_keys": F.pool_completed_index_keys(
+            ik, ip, compress_ratio=ratio, index_key_norm=ident, apply_index_rope=ident_rope
+        ),
+    }
+
+    calls = []
+    real = qsa_nax.sparse_gqa_attention_tq
+
+    def counting(*args, _real=real, _calls=calls, **kw):
+        out = _real(*args, **kw)
+        _calls.append(out is not None)
+        return out
+
+    qsa_nax.sparse_gqa_attention_tq = counting
+    try:
+        monkeypatch.setattr(F, "_NAX_QSA_TQ_DISABLED", False)
+        monkeypatch.setenv("OMLX_QWEN4_QSA_NAX_TQ", "0")
+        assert qsa_nax.tq_enabled() is False
+        assert qsa_nax.tq_supported(6, 6) is False
+        off = F.contiguous_causal_gathered_qsa_tq(qs, hybrid, iq, ik, ip, **kwargs)
+        mx.eval(off)
+        assert calls == [], "kill switch off but the fused kernel still ran"
+        assert off.shape == (1, queries, heads, dim)
+        assert mx.isfinite(off).all().item()
+
+        calls.clear()
+        monkeypatch.delenv("OMLX_QWEN4_QSA_NAX_TQ")
+        assert qsa_nax.tq_supported(6, 6) is True
+        on = F.contiguous_causal_gathered_qsa_tq(qs, hybrid, iq, ik, ip, **kwargs)
+        mx.eval(on)
+        assert calls and all(calls), "arm live but never engaged"
+        assert _cosine(on, off) > 0.999, "fused and compiled arms disagree"
+    finally:
+        qsa_nax.sparse_gqa_attention_tq = real
+
+
+@pytest.mark.parametrize("chunk", [2, 8, 16])
+def test_fused_packed_arm_covers_short_tail_chunks(chunk, monkeypatch):
+    """Prompt tail chunks below the native arm's 24-row floor stay on the
+    tensor units.
+
+    ``_native_main_min_rows`` exists because the compiled native kernel loses to
+    a gathered SDPA on short chunks - both of those scale with query rows. The
+    fused arm walks the selected blocks once whatever the row count, so reusing
+    that threshold made every prompt whose length is not a multiple of
+    ``contiguous_causal_query_chunk`` fall past both fast arms into the portable
+    whole-union gather: 1.4x slower at 4 rows, 4.9x at 16 rows and 65k context.
+    A tail chunk must therefore stay on the fused kernel, and stay as accurate as
+    a full-width chunk, since it is the same kernel over the same packed rows.
+    """
+    from mlx_vlm.models.qwen4_exp import qsa_fast as F
+    from mlx_vlm.models.qwen4_exp import qsa_nax
+
+    heads, kv_heads, dim, idx_dim, ratio, tokens = 24, 2, 256, 128, 4, 8192
+    if not qsa_nax.tq_supported(6, 6):
+        pytest.skip("tensor-unit packed arm unavailable on this GPU or switched off")
+    assert F._nax_tq_min_rows() <= chunk, "threshold no longer exercises the short path"
+
+    def ident(x):
+        return x
+
+    def ident_rope(x, positions):
+        return x
+
+    rng = _rng(1700 + chunk)
+    keys = mx.array(rng.standard_normal((1, kv_heads, tokens, dim)).astype(np.float32))
+    values = mx.array(rng.standard_normal((1, kv_heads, tokens, dim)).astype(np.float32))
+    dense = QSAKVCache()
+    dense.update_and_fetch(keys, values)
+    ik = mx.array(rng.standard_normal((1, tokens, idx_dim)).astype(np.float32))
+    ip = mx.arange(tokens, dtype=mx.int32)[None, :]
+    dense.update_indexer(ik, ip)
+    hybrid = TurboQuantQSAKVCache.from_qsa_cache(dense, bits=6)
+    iq = mx.array(rng.standard_normal((1, chunk, 2, idx_dim)).astype(np.float32))
+    qs = mx.array(
+        rng.standard_normal((1, heads, chunk, dim)).astype(np.float32)
+    ).astype(mx.bfloat16)
+    kwargs = {
+        "num_query_heads": heads,
+        "num_key_value_heads": kv_heads,
+        "head_dim": dim,
+        "indexer_head_dim": idx_dim,
+        "compress_ratio": ratio,
+        "token_budget": 2048,
+        "index_key_norm": ident,
+        "apply_index_rope": ident_rope,
+        "pooled_index_keys": F.pool_completed_index_keys(
+            ik, ip, compress_ratio=ratio, index_key_norm=ident, apply_index_rope=ident_rope
+        ),
+    }
+
+    hits = []
+    real = qsa_nax.sparse_gqa_attention_tq
+
+    def counting(*args, _real=real, _hits=hits, **kw):
+        out = _real(*args, **kw)
+        _hits.append(out is not None)
+        return out
+
+    monkeypatch.setattr(F, "_NAX_QSA_TQ_DISABLED", False)
+    qsa_nax.sparse_gqa_attention_tq = counting
+    try:
+        out = F.contiguous_causal_gathered_qsa_tq(qs, hybrid, iq, ik, ip, **kwargs)
+        deq_k, deq_v = hybrid.gather_dequantized_rows(
+            mx.arange(tokens, dtype=mx.int32)[None, :]
+        )
+        exact = F.contiguous_causal_gathered_qsa(
+            qs,
+            deq_k.astype(mx.bfloat16),
+            deq_v.astype(mx.bfloat16),
+            iq,
+            ik,
+            ip,
+            **kwargs,
+        )
+        mx.eval(out, exact)
+    finally:
+        qsa_nax.sparse_gqa_attention_tq = real
+
+    assert hits and all(hits), f"tail chunk of {chunk} rows left the tensor units"
+    assert out.shape == (1, chunk, heads, dim)
+    assert mx.isfinite(out).all().item()
+    r = float(
+        mx.linalg.norm((out - exact).astype(mx.float32).reshape(-1))
+        / max(float(mx.linalg.norm(exact.astype(mx.float32).reshape(-1))), 1e-9)
+    )
+    assert r < 0.01, f"relL2 {r:.5f} at {chunk}-row tail chunk"
