+# ---------------------------------------------------------------------------
+# Phase 4: fused NAX tensor-unit prefill on packed rows
+# ---------------------------------------------------------------------------
+
+
+@pytest.mark.parametrize("bits", [2, 2.5, 3, 3.5, 4, 6, 8])
+def test_nax_packed_prefill_arm_engages_and_error_is_bounded_in_context(
+    bits, monkeypatch
+):
+    """The fused tensor-unit packed arm runs at production shape, and its
+    deviation from exact attention does not grow with context.
+
+    Enabling TurboQuant used to drop prefill off the NAX tensor units: the
+    packed arm fell through to the compiled simdgroup-MMA kernel, so on a
+    tensor-unit GPU the memory saving was paid for with engine throughput. The
+    fused arm keeps the tensor units and still reads the packed bitstream.
+
+    Both arms are compared against dense attention over the *same* dequantized
+    K/V, so codec error cancels by construction and only kernel deviation
+    remains; per-token norms and per-query softmax renormalization must keep
+    that flat across a 4x context span rather than accumulating as session
+    drift.
+    """
+    from mlx_vlm.models.qwen4_exp import qsa_fast as F
+    from mlx_vlm.models.qwen4_exp import qsa_nax
+
+    heads, kv_heads, dim, idx_dim, ratio = 24, 2, 256, 128, 4
+    token_budget = 2048  # block_budget == 512: the full selection list
+
+    if not qsa_nax.tq_supported(bits, bits):
+        pytest.skip(
+            "tensor-unit packed arm unavailable: non-NAX GPU, or retired by "
+            "OMLX_QWEN4_QSA_NAX / OMLX_QWEN4_QSA_NAX_TQ"
+        )
+
+    def ident(x):
+        return x
+
+    def ident_rope(x, positions):
+        return x
+
+    rel = {}
+    for tokens, queries in ((4096, 32), (16384, 64)):
+        # Seed as an int: widths include fractional 2.5/3.5, scaled by 10 so each
+        # distinct codec pair still gets its own deterministic stream.
+        rng = _rng(int(round(bits * 10)) * 13 + tokens)
+        keys = mx.array(
+            rng.standard_normal((1, kv_heads, tokens, dim)).astype(np.float32)
+        )
+        values = mx.array(
+            rng.standard_normal((1, kv_heads, tokens, dim)).astype(np.float32)
+        )
+        dense = QSAKVCache()
+        dense.update_and_fetch(keys, values)
+        ik = mx.array(rng.standard_normal((1, tokens, idx_dim)).astype(np.float32))
+        ip = mx.arange(tokens, dtype=mx.int32)[None, :]
+        dense.update_indexer(ik, ip)
+        hybrid = TurboQuantQSAKVCache.from_qsa_cache(dense, bits=bits)
+
+        iq = mx.array(rng.standard_normal((1, queries, 2, idx_dim)).astype(np.float32))
+        qs = mx.array(
+            rng.standard_normal((1, heads, queries, dim)).astype(np.float32)
+        ).astype(mx.bfloat16)
+        pooled = F.pool_completed_index_keys(
+            ik,
+            ip,
+            compress_ratio=ratio,
+            index_key_norm=ident,
+            apply_index_rope=ident_rope,
+        )
+        kwargs = {
+            "num_query_heads": heads,
+            "num_key_value_heads": kv_heads,
+            "head_dim": dim,
+            "indexer_head_dim": idx_dim,
+            "compress_ratio": ratio,
+            "token_budget": token_budget,
+            "index_key_norm": ident,
+            "apply_index_rope": ident_rope,
+            "pooled_index_keys": pooled,
+        }
+
+        reached = []
+        real = qsa_nax.sparse_gqa_attention_tq
+
+        def counting(*args, _real=real, _reached=reached, **kw):
+            out = _real(*args, **kw)
+            _reached.append(out is not None)
+            return out
+
+        # A prior arm failure latches the kill switch process-wide, and this
+        # test must assert the arm is live. Both writes go through monkeypatch
+        # so the latch cannot leak into the rest of the session and silently
+        # disable the fused arm for every later test.
+        monkeypatch.setattr(F, "_NAX_QSA_TQ_DISABLED", False)
+        monkeypatch.setattr(F, "_NAX_QSA_TQ_PROVEN", False)
+        qsa_nax.sparse_gqa_attention_tq = counting
+        try:
+            deq_k, deq_v = hybrid.gather_dequantized_rows(
+                mx.arange(tokens, dtype=mx.int32)[None, :]
+            )
+            exact = F.contiguous_causal_gathered_qsa(
+                qs,
+                deq_k.astype(mx.bfloat16),
+                deq_v.astype(mx.bfloat16),
+                iq,
+                ik,
+                ip,
+                **kwargs,
+            )
+            fused = F.contiguous_causal_gathered_qsa_tq(
+                qs, hybrid, iq, ik, ip, **kwargs
+            )
+            mx.eval(exact, fused)
+        finally:
+            qsa_nax.sparse_gqa_attention_tq = real
+
+        assert reached and all(reached), (
+            "NAX packed arm never engaged at production shape "
+            f"(tokens={tokens}, calls={len(reached)})"
+        )
+        assert F._NAX_QSA_TQ_PROVEN is True
+        assert fused.shape == exact.shape
+        assert mx.isfinite(fused).all().item()
+
+        r = float(
+            mx.linalg.norm((fused - exact).astype(mx.float32).reshape(-1))
+            / max(float(mx.linalg.norm(exact.astype(mx.float32).reshape(-1))), 1e-9)
+        )
+        # bf16 operands: sub-1% against the identical dequantized reference,
+        # more than an order of magnitude inside the 0.15 codec tolerance.
+        assert r < 0.01, f"relL2 {r:.5f} vs exact-on-dequantized at {tokens} tokens"
+        assert _cosine(fused, exact) > 0.9999
+        rel[tokens] = r
+
+    assert rel[16384] <= 1.5 * rel[4096], (
+        f"kernel deviation grew with context: {rel[4096]:.5f} -> {rel[16384]:.5f}"
+    )
+
+
+def test_nax_packed_arm_gate_mirrors_the_native_kernel_width_vocabulary():
+    """The fused NAX arm admits exactly the widths the native kernel implements.
+
+    The TurboQuant codec accepts any half-integer width >= 1, and fractional
+    widths split into a floor/ceil codec pair (2.5 -> (2, 3), 3.5 -> (3, 4)),
+    but only a fixed set of integer pairs is compiled into the native packed
+    kernel. The tensor-unit arm must offer the same set - not one width less
+    (so a low-bit model no longer drops off the tensor units into the ~8x
+    slower portable gather), and not one width more (so it never claims a
+    shape the codec and native kernel cannot actually produce). 5- and 7-bit
+    appear nowhere in the stack, so they must stay closed.
+    """
+    from mlx_vlm.models.qwen4_exp import qsa_fast as F
+    from mlx_vlm.models.qwen4_exp import qsa_nax
+
+    native = F._TQ_NATIVE_BIT_PAIRS
+    arm = qsa_nax._TQ_BIT_PAIRS
+    assert arm == native, (
+        "NAX packed-arm width set drifted from the native kernel vocabulary: "
+        f"extra={sorted(arm - native)} missing={sorted(native - arm)}"
+    )
+
+    # Every native pair is supported by the probe (env kill switches unset).
+    for pair in sorted(native):
+        assert qsa_nax.tq_supported(*pair) is True, f"{pair} must be admitted"
+
+    # Widths with no instantiation anywhere in the stack stay refused.
+    for pair in ((5, 5), (7, 7), (0, 0), (9, 9), (2, 4), (4, 6), (3, 6)):
+        assert qsa_nax.tq_supported(*pair) is False, f"{pair} must be refused"
+
