diff --git a/tests/test_admission_budget.py b/tests/test_admission_budget.py
new file mode 100644
index 00000000..e04e1d34
--- /dev/null
+++ b/tests/test_admission_budget.py
@@ -0,0 +1,265 @@
+"""Memory-budget admission: queue instead of reject, reserve future KV, backfill."""
+
+from __future__ import annotations
+
+import logging
+import time
+from collections import deque
+from types import SimpleNamespace
+
+import pytest
+
+from omlx.exceptions import PrefillMemoryExceededError
+from omlx.scheduler import Scheduler
+
+GB = 1024**3
+KV_PER_TOKEN = 1024 * 1024  # 1 MB per token keeps the numbers readable
+
+
+class _Monitor:
+    @staticmethod
+    def estimate_resident_kv_bytes(tokens, *, chunk_tokens=1):
+        return tokens * KV_PER_TOKEN
+
+
+def _req(rid, prompt_tokens, max_tokens=0, arrival=None):
+    r = SimpleNamespace(
+        request_id=rid,
+        num_prompt_tokens=prompt_tokens,
+        sampling_params=SimpleNamespace(max_tokens=max_tokens),
+        cached_tokens=0,
+        output_token_ids=[],
+    )
+    r.arrival_time = time.monotonic() if arrival is None else arrival
+    return r
+
+
+def _sched(*, current_gb=10, limit_gb=100, transient_gb=0, deferred=()):
+    s = SimpleNamespace()
+    s.waiting = deque()
+    s.running = {}
+    s.prefilling = deque()
+    s.requests = {}
+    s.memory_monitor = _Monitor()
+    s._prefill_memory_guard = True
+    s._memory_hard_limit_bytes = limit_gb * GB
+    s._num_admitted_requests = lambda: len(s.running) + len(s.prefilling)
+    s._admission_limit_bytes = lambda: limit_gb * GB
+    s._current_usage_bytes = lambda refresh_mlx_active=True: current_gb * GB
+    s._releasable_hot_cache_credit = lambda own: 0
+    s._should_defer_for_cache_freshness = lambda r: r.request_id in deferred
+    s._admission_estimate = lambda **kw: SimpleNamespace(
+        transient=transient_gb * GB,
+        kv_exact=kw["num_prompt_tokens"] * KV_PER_TOKEN,
+        estimated=kw["current"] + kw["num_prompt_tokens"] * KV_PER_TOKEN + transient_gb * GB,
+        floor_chunk=1,
+        kv_len=kw["num_prompt_tokens"],
+    )
+    s.released = []
+    s._release_paged_cache_for_request = lambda rid: s.released.append(rid)
+    s._clear_request_admission_bookkeeping = lambda rid: None
+    return s
+
+
+@pytest.fixture(autouse=True)
+def _env(monkeypatch):
+    for name in (
+        "OMLX_ADMISSION_BUDGET",
+        "OMLX_ADMISSION_MAX_QUEUE_S",
+        "OMLX_ADMISSION_AGING_S",
+        "OMLX_ADMISSION_DECODE_RESERVE",
+    ):
+        monkeypatch.delenv(name, raising=False)
+    # The SSD prefetch gate may or may not exist in this tree; keep it inert.
+    monkeypatch.setattr(
+        Scheduler, "_should_defer_for_ssd_prefetch", lambda self, r: False, raising=False
+    )
+
+
+def _admit(s, r, reserved):
+    r._budget_reserved_tokens = reserved
+    s.running[r.request_id] = r
+
+
+class TestPickHead:
+    def test_idle_engine_admits_head_whatever_its_size(self):
+        s = _sched(current_gb=10, limit_gb=20)
+        big = _req("big", 500_000)
+        s.waiting.extend([big])
+        assert Scheduler._budget_pick_head(s) is True
+        assert s.waiting[0] is big
+        assert big._budget_reserved_tokens == 500_000 + 2048  # default decode reserve
+
+    def test_reserves_future_growth_of_running_requests(self):
+        # 10 GB in use, running request reserved 60 GB of KV but holds none yet.
+        s = _sched(current_gb=10, limit_gb=100)
+        running = _req("run", 0)  # nothing allocated yet
+        _admit(s, running, 60 * 1024)
+        new = _req("new", 40 * 1024)
+        s.waiting.append(new)
+        # 10 + 60 (outstanding) + 40 = 110 GB > 100 GB -> held, not admitted.
+        assert Scheduler._budget_pick_head(s) is False
+        assert "_budget_held_since" in vars(new)
+        # Once the running request has allocated its KV, only `current` counts it.
+        running.output_token_ids = []
+        running.num_prompt_tokens = 60 * 1024
+        s._current_usage_bytes = lambda refresh_mlx_active=True: 50 * GB
+        # 50 + 0 + 40 = 90 GB -> fits.
+        assert Scheduler._budget_pick_head(s) is True
+        assert vars(new).get("_budget_held_since") is None
+
+    def test_small_request_backfills_past_held_head(self, caplog):
+        s = _sched(current_gb=50, limit_gb=100)
+        _admit(s, _req("run", 1), 1)
+        big = _req("big", 80 * 1024)
+        small = _req("small", 1024)
+        s.waiting.extend([big, small])
+        with caplog.at_level(logging.INFO, logger="omlx.scheduler"):
+            assert Scheduler._budget_pick_head(s) is True
+        assert list(s.waiting) == [small, big]
+        assert "holding big" in caplog.text
+        assert "admitting small ahead of big" in caplog.text
+
+    def test_decision_logged_once_per_change(self, caplog):
+        s = _sched(current_gb=95, limit_gb=100)
+        _admit(s, _req("run", 1), 1)
+        s.waiting.append(_req("a", 10 * 1024))
+        with caplog.at_level(logging.DEBUG, logger="omlx.scheduler"):
+            for _ in range(50):
+                Scheduler._budget_pick_head(s)
+        assert caplog.text.count("Admission budget: a does not fit") == 1
+
+    def test_aged_held_head_stops_backfill(self, monkeypatch):
+        monkeypatch.setenv("OMLX_ADMISSION_AGING_S", "30")
+        s = _sched(current_gb=50, limit_gb=100)
+        _admit(s, _req("run", 1), 1)
+        big = _req("big", 80 * 1024)
+        big._budget_held_since = time.monotonic() - 31
+        small = _req("small", 1024)
+        s.waiting.extend([big, small])
+        assert Scheduler._budget_pick_head(s) is False
+        assert list(s.waiting) == [big, small]
+
+    def test_deferred_head_lets_next_request_in(self):
+        s = _sched(deferred={"head"})
+        _admit(s, _req("run", 1), 1)
+        head, nxt = _req("head", 1024), _req("next", 1024)
+        s.waiting.extend([head, nxt])
+        assert Scheduler._budget_pick_head(s) is True
+        assert s.waiting[0] is nxt
+
+    def test_only_deferred_requests_fall_back_to_upstream_head_path(self):
+        s = _sched(deferred={"head", "next"})
+        _admit(s, _req("run", 1), 1)
+        head, nxt = _req("head", 1024), _req("next", 1024)
+        s.waiting.extend([head, nxt])
+        # True + unchanged order: the loop then runs its own deferral checks.
+        assert Scheduler._budget_pick_head(s) is True
+        assert list(s.waiting) == [head, nxt]
+
+    def test_ssd_prefetch_deferral_is_skipped_too(self, monkeypatch):
+        monkeypatch.setattr(
+            Scheduler,
+            "_should_defer_for_ssd_prefetch",
+            lambda self, r: r.request_id == "head",
+            raising=False,
+        )
+        s = _sched()
+        _admit(s, _req("run", 1), 1)
+        head, nxt = _req("head", 1024), _req("next", 1024)
+        s.waiting.extend([head, nxt])
+        assert Scheduler._budget_pick_head(s) is True
+        assert s.waiting[0] is nxt
+
+    def test_nothing_fits(self):
+        s = _sched(current_gb=95, limit_gb=100)
+        _admit(s, _req("run", 1), 1)
+        s.waiting.extend([_req("a", 10 * 1024), _req("b", 10 * 1024)])
+        assert Scheduler._budget_pick_head(s) is False
+
+    def test_decode_reserve_capped_by_max_tokens(self, monkeypatch):
+        monkeypatch.setenv("OMLX_ADMISSION_DECODE_RESERVE", "4096")
+        s = _sched()
+        assert Scheduler._budget_need(s, _req("a", 100, max_tokens=50))[0] == 150
+        assert Scheduler._budget_need(s, _req("b", 100, max_tokens=0))[0] == 4196
+
+    def test_largest_live_transient_is_charged(self):
+        s = _sched(current_gb=10, limit_gb=90, transient_gb=5)
+        pre = _req("pre", 1024)
+        pre._budget_reserved_tokens = 1024
+        pre._budget_transient = 30 * GB
+        s.prefilling.append(pre)
+        new = _req("new", 50 * 1024)
+        s.waiting.append(new)
+        # 10 + 1 (pre's KV still to allocate) + 50 + max(30, 5) = 91 GB > 90 GB;
+        # without the live transient it would be 66 GB and fit.
+        assert Scheduler._budget_pick_head(s) is False
+
+    def test_disabled_by_env(self, monkeypatch):
+        monkeypatch.setenv("OMLX_ADMISSION_BUDGET", "0")
+        s = _sched(current_gb=95, limit_gb=100)
+        _admit(s, _req("run", 1), 1)
+        s.waiting.append(_req("a", 50 * 1024))
+        assert Scheduler._budget_pick_head(s) is True
+        assert Scheduler._budget_expire_waiting(s) == []
+
+    def test_failure_falls_back_to_queue_order(self):
+        s = _sched()
+        _admit(s, _req("run", 1), 1)
+        s.waiting.append(_req("a", 1))
+
+        def boom(**_kw):
+            raise RuntimeError("estimate broke")
+
+        s._admission_estimate = boom
+        assert Scheduler._budget_pick_head(s) is True
+
+
+class TestExpire:
+    def test_held_request_past_max_wait_is_rejected(self, monkeypatch):
+        monkeypatch.setenv("OMLX_ADMISSION_MAX_QUEUE_S", "10")
+        s = _sched()
+        old = _req("old", 1024, arrival=time.monotonic() - 11)
+        old._budget_held_since = time.monotonic() - 5
+        young = _req("young", 1024, arrival=time.monotonic() - 11)  # never held
+        s.waiting.extend([old, young])
+        s.requests = {"old": old, "young": young}
+        out = Scheduler._budget_expire_waiting(s)
+        assert [o.request_id for o in out] == ["old"]
+        assert out[0].error_code == "prefill_memory_exceeded"
+        assert "waited" in out[0].error
+        assert list(s.waiting) == [young]
+        assert s.released == ["old"] and "old" not in s.requests
+
+    def test_zero_disables_the_limit(self, monkeypatch):
+        monkeypatch.setenv("OMLX_ADMISSION_MAX_QUEUE_S", "0")
+        s = _sched()
+        r = _req("r", 1, arrival=time.monotonic() - 10_000)
+        r._budget_held_since = r.arrival_time
+        s.waiting.append(r)
+        assert Scheduler._budget_expire_waiting(s) == []
