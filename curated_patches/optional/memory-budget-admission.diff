+    # ------------------------------------------------------------------
+    # Memory-budget admission.
+    #
+    # The admission estimate (_admission_estimate) prices a new request
+    # against the memory in use NOW. A running request that is still
+    # prefilling or decoding will allocate more, and that future growth is
+    # invisible, so two large requests can both pass and then collide. And a
+    # request that does not fit now is rejected even when it would fit as
+    # soon as the running work finishes.
+    #
+    # The budget keeps a per-request reservation (the KV of the whole prompt
+    # plus a capped decode allowance) and admits a waiting request only when
+    #   current + not-yet-allocated part of every reservation
+    #           + its own reservation + the largest live prefill transient
+    # stays under the admission limit. A request that does not fit WAITS in
+    # the queue instead of being rejected; it is rejected (same
+    # prefill_memory_exceeded error as before) only after it has waited
+    # OMLX_ADMISSION_MAX_QUEUE_S. Smaller requests that fit may go ahead of
+    # a held or deferred head (backfill), until the held head has waited
+    # OMLX_ADMISSION_AGING_S; from then on the queue holds for it, so large
+    # requests do not starve. The first request always passes when nothing
+    # is admitted, as with the other guards, and the existing estimate,
+    # chunk guard and enforcer still protect every admitted request.
+    # OMLX_ADMISSION_BUDGET=0 restores the old behavior.
+    # ------------------------------------------------------------------
+    _BUDGET_SCAN_LIMIT = 16
+
+    @staticmethod
+    def _battr(obj: Any, name: str) -> Any:
+        """Budget markers live in the instance dict (mocks and stubs stay inert)."""
+        try:
+            return vars(obj).get(name)
+        except TypeError:
+            return None
+
+    @staticmethod
+    def _budget_env_float(name: str, default: float) -> float:
+        import os
+
+        raw = os.environ.get(name)
+        if raw is None or not raw.strip():
+            return default
+        try:
+            return float(raw)
+        except ValueError:
+            return default
+
+    @staticmethod
+    def _budget_enabled() -> bool:
+        import os
+
+        return os.environ.get("OMLX_ADMISSION_BUDGET", "1").strip().lower() not in (
+            "0",
+            "false",
+            "no",
+            "off",
+        )
+
+    def _budget_kv_bytes(self, tokens: int) -> int:
+        monitor = self.memory_monitor
+        if monitor is None or tokens <= 0:
+            return 0
+        return int(monitor.estimate_resident_kv_bytes(int(tokens), chunk_tokens=1))
+
+    def _budget_need(self, request: Request) -> tuple[int, int, int]:
+        """(reserved tokens, reserved KV bytes, prefill transient bytes)."""
+        cached = Scheduler._battr(request, "_budget_need_cache")
+        if cached is not None:
+            return cached
+        prompt = int(getattr(request, "num_prompt_tokens", 0) or 0) + _request_count(
+            request, "requeued_output_tokens"
+        )
+        reserve = int(
+            Scheduler._budget_env_float("OMLX_ADMISSION_DECODE_RESERVE", 2048.0)
+        )
+        max_tokens = getattr(getattr(request, "sampling_params", None), "max_tokens", None)
+        if isinstance(max_tokens, int) and max_tokens > 0:
+            reserve = min(reserve, max_tokens)
+        tokens = prompt + max(0, reserve)
+        kv = Scheduler._budget_kv_bytes(self, tokens)
+        transient = 0
+        est = self._admission_estimate(
+            num_prompt_tokens=prompt, cached_tokens=0, current=0
+        )
+        if est is not None:
+            transient = int(est.transient)
+        need = (tokens, kv, transient)
+        request._budget_need_cache = need
+        return need
+
+    def _budget_committed(self) -> tuple[int, int]:
+        """(KV still to be allocated by admitted requests, largest live transient)."""
+        outstanding = 0
+        transient = 0
+        tracker = get_prefill_tracker()
+        prefilling_ids = {r.request_id for r in self.prefilling}
+        for r in list(self.running.values()) + list(self.prefilling):
+            reserved = Scheduler._battr(r, "_budget_reserved_tokens")
+            if not reserved:
+                continue
+            if r.request_id in prefilling_ids:
+                entry = tracker.get(r.request_id) or {}
+                done = max(
+                    int(getattr(r, "cached_tokens", 0) or 0),
+                    int(entry.get("processed", 0) or 0),
+                )
+                transient = max(transient, int(Scheduler._battr(r, "_budget_transient") or 0))
+            else:
+                done = int(getattr(r, "num_prompt_tokens", 0) or 0) + len(
+                    getattr(r, "output_token_ids", None) or ()
+                )
+            if done < reserved:
+                outstanding += max(
+                    0,
+                    Scheduler._budget_kv_bytes(self, reserved)
+                    - Scheduler._budget_kv_bytes(self, done),
+                )
+        return outstanding, transient
+
+    def _budget_deferred(self, request: Request) -> bool:
+        """Same deferral checks the admission loop applies to its head."""
+        if self._should_defer_for_cache_freshness(request):
+            return True
+        prefetch = getattr(Scheduler, "_should_defer_for_ssd_prefetch", None)
+        if prefetch is not None and prefetch(self, request):
+            return True
+        return False
+
+    def _budget_pick_head(self) -> bool:
+        """Put the request to admit next at waiting[0]; False = admit none now.
+
+        Never raises: any failure falls back to the old head-of-line order.
+        """
+        if not Scheduler._budget_enabled() or not self.waiting:
+            return True
+        try:
+            return Scheduler._budget_pick_head_inner(self)
+        except Exception as exc:  # noqa: BLE001 - never break admission
+            logger.warning("Admission budget failed, using queue order: %s", exc)
+            return True
+
+    def _budget_pick_head_inner(self) -> bool:
+        admitted = self._num_admitted_requests()
+        limit = self._admission_limit_bytes() if self.memory_monitor is not None else 0
+        guard = bool(self._prefill_memory_guard) and limit > 0
+        outstanding, live_transient = (
+            Scheduler._budget_committed(self) if guard and admitted else (0, 0)
+        )
+        current = self._current_usage_bytes(refresh_mlx_active=False) if guard else 0
+        now = time.monotonic()
+        aging = Scheduler._budget_env_float("OMLX_ADMISSION_AGING_S", 60.0)
+        head_id = self.waiting[0].request_id
+        skipped: list[str] = []
+        held_any = False
+        for idx, request in enumerate(list(self.waiting)):
+            if idx >= Scheduler._BUDGET_SCAN_LIMIT:
+                break
+            fits = True
+            need = None
+            if guard and admitted:
+                need = Scheduler._budget_need(self, request)
+                _tokens, kv, transient = need
+                credit = 0
+                try:
+                    credit = int(self._releasable_hot_cache_credit(kv))
+                except Exception:  # noqa: BLE001
+                    credit = 0
+                projected = (
+                    current + outstanding + kv + max(live_transient, transient) - credit
+                )
+                fits = projected <= limit
+                if Scheduler._battr(request, "_budget_last_fit") is not fits:
+                    request._budget_last_fit = fits
+                    logger.debug(
+                        "Admission budget: %s %s (projected %s = in use %s + still "
+                        "to be allocated %s + own KV %s + transient %s - hot-cache "
+                        "credit %s; limit %s; %d admitted)",
+                        request.request_id,
+                        "fits" if fits else "does not fit",
+                        format_bytes(projected),
+                        format_bytes(current),
+                        format_bytes(outstanding),
+                        format_bytes(kv),
+                        format_bytes(max(live_transient, transient)),
+                        format_bytes(credit),
+                        format_bytes(limit),
+                        admitted,
+                    )
+            if not fits:
+                held_any = True
+                if Scheduler._battr(request, "_budget_held_since") is None:
+                    request._budget_held_since = now
+                    logger.info(
+                        "Admission budget: holding %s in the queue (needs %s KV + "
+                        "%s prefill transient; in use %s, still to be allocated "
+                        "by %d admitted request(s) %s, limit %s)",
+                        request.request_id,
+                        format_bytes(need[1]),
+                        format_bytes(need[2]),
+                        format_bytes(current),
+                        admitted,
+                        format_bytes(outstanding),
+                        format_bytes(limit),
+                    )
+                if now - request._budget_held_since >= aging:
+                    # Held long enough: stop letting later requests pass it.
+                    return False
+                skipped.append(request.request_id)
+                continue
+            if Scheduler._budget_deferred(self, request):
+                skipped.append(request.request_id)
+                continue
+            held_since = Scheduler._battr(request, "_budget_held_since")
+            if held_since is not None:
+                logger.info(
+                    "Admission budget: admitting %s after %.1fs held for memory",
+                    request.request_id,
+                    now - held_since,
+                )
+                request._budget_held_since = None
+            if idx > 0:
+                del self.waiting[idx]
+                self.waiting.appendleft(request)
+                logger.info(
+                    "Admission budget: admitting %s ahead of %s (held for memory "
+                    "or deferred: %s)",
+                    request.request_id,
+                    head_id,
+                    ", ".join(skipped),
+                )
+            tokens, _kv, transient = (
+                need if need is not None else Scheduler._budget_need(self, request)
+            )
+            request._budget_reserved_tokens = tokens
+            request._budget_transient = transient
+            request._budget_need_cache = None  # a requeue changes the size
+            return True
+        # Nothing admissible. Held for memory: hold the queue. Only deferred:
+        # let the loop run its own head checks (upstream behavior exactly).
+        return not held_any
+
+    def _budget_expire_waiting(self) -> list[RequestOutput]:
+        """Reject requests held for memory past OMLX_ADMISSION_MAX_QUEUE_S."""
+        if not Scheduler._budget_enabled() or not self.waiting:
+            return []
+        max_wait = Scheduler._budget_env_float("OMLX_ADMISSION_MAX_QUEUE_S", 600.0)
+        if max_wait <= 0:
+            return []
+        now = time.monotonic()
+        out: list[RequestOutput] = []
+        for request in list(self.waiting):
+            if Scheduler._battr(request, "_budget_held_since") is None:
+                continue
+            arrived = getattr(request, "arrival_time", None) or request._budget_held_since
+            waited = now - arrived
+            if waited < max_wait:
+                continue
+            request_id = request.request_id
+            try:
+                self.waiting.remove(request)
+            except ValueError:
+                continue
+            self._release_paged_cache_for_request(request_id)
+            self.requests.pop(request_id, None)
+            self._clear_request_admission_bookkeeping(request_id)
+            get_prefill_tracker().remove(request_id)
+            _tokens, kv, transient = Scheduler._budget_need(self, request)
+            limit = self._admission_limit_bytes()
+            message = (
+                f"Request waited {waited:.0f}s in the queue for memory and was not "
+                f"admitted (needs about {format_bytes(kv)} KV + "
+                f"{format_bytes(transient)} prefill transient, limit "
+                f"{format_bytes(limit)}). Retry later, reduce context length, or "
+                "raise OMLX_ADMISSION_MAX_QUEUE_S."
+            )
+            logger.warning("Admission budget: rejecting %s: %s", request_id, message)
+            out.append(
+                _prefill_memory_error_output(
+                    request_id,
+                    message,
+                    estimated_bytes=int(kv + transient),
+                    limit_bytes=int(limit),
+                )
+            )
+        return out
+
+    def _budget_queue_instead_of_reject(self) -> bool:
+        """Route preflight: True = let a busy engine queue the request."""
+        if not Scheduler._budget_enabled():
+            return False
+        return bool(self._num_admitted_requests() or self.waiting)
+
