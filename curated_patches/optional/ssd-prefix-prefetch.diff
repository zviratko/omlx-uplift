@@ -0,0 +1,191 @@
+"""SSD prefix prefetch: read SSD-only prefix blocks off the inference thread."""
+
+from __future__ import annotations
+
+import concurrent.futures
+import logging
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+from omlx.cache.paged_ssd_cache import PagedSSDCacheManager
+from omlx.scheduler import Scheduler
+
+
+def _manager(tmp_path: Path, hot_cache_bytes: int = 0) -> PagedSSDCacheManager:
+    return PagedSSDCacheManager(
+        cache_dir=tmp_path / "ssd_cache",
+        max_size_bytes=1024**3,
+        hot_cache_max_bytes=hot_cache_bytes,
+    )
+
+
+def _save(manager, mx, block_hash: bytes) -> None:
+    cache_data = [(mx.zeros((1, 2, 16, 8)), mx.zeros((1, 2, 16, 8))) for _ in range(2)]
+    assert manager.save_block(
+        block_hash=block_hash,
+        cache_data=cache_data,
+        token_count=16,
+        model_name="test-model",
+        layer_cache_types=["KVCache"] * 2,
+    )
+    assert manager.wait_for_pending_writes(10.0)
+
+
+class TestPrefetchCandidates:
+    @pytest.fixture
+    def mock_mlx(self):
+        return pytest.importorskip("mlx.core")
+
+    def test_lists_disk_only_blocks_and_warms_them(self, tmp_path, mock_mlx):
+        manager = _manager(tmp_path)
+        try:
+            hashes = [bytes([i]) * 32 for i in (1, 2)]
+            for h in hashes:
+                _save(manager, mock_mlx, h)
+            files = manager.prefetch_candidates(hashes)
+            assert [p for p, _ in files] == [
+                manager.get_block_metadata(h).file_path for h in hashes
+            ]
+            n_files, n_bytes = PagedSSDCacheManager.warm_files(files, chunk_bytes=1024)
+            assert n_files == 2
+            assert n_bytes == sum(p.stat().st_size for p, _ in files)
+        finally:
+            manager.close()
+
+    def test_stops_at_unknown_block(self, tmp_path, mock_mlx):
+        manager = _manager(tmp_path)
+        try:
+            known = b"\x01" * 32
+            _save(manager, mock_mlx, known)
+            files = manager.prefetch_candidates([known, b"\x09" * 32, known])
+            assert len(files) == 1
+        finally:
+            manager.close()
+
+    def test_skips_hot_cache_blocks(self, tmp_path, mock_mlx):
+        manager = _manager(tmp_path, hot_cache_bytes=64 * 1024**2)
+        try:
+            h = b"\x03" * 32
+            _save(manager, mock_mlx, h)
+            assert manager.prefetch_candidates([h]) == []
+        finally:
+            manager.close()
+
+    def test_warm_files_survives_missing_file(self, tmp_path):
+        good = tmp_path / "a.bin"
+        good.write_bytes(b"x" * 5000)
+        files = [(tmp_path / "missing.bin", 10), (good, 5000)]
+        assert PagedSSDCacheManager.warm_files(files, chunk_bytes=1024) == (1, 5000)
+
+
+class _FakePrefixCache:
+    def __init__(self, files):
+        self.files = files
+        self.calls = 0
+
+    def ssd_prefetch_candidates(self, tokens, **_kwargs):
+        self.calls += 1
+        return self.files
+
+
+class _FakeManager:
+    started = None
+
+    @staticmethod
+    def prefetch_candidates(_hashes):
+        return []
+
+    @staticmethod
+    def warm_files(files):
+        if _FakeManager.started is not None:
+            _FakeManager.started.wait(5)
+        return len(files), sum(size for _p, size in files)
+
+
+def _stub(files):
+    request = SimpleNamespace(
+        request_id="r1",
+        prompt_token_ids=[1, 2, 3],
+        vlm_extra_keys_for_cache=None,
+        vlm_extra_key_token_start_for_cache=None,
+        vlm_extra_key_ranges_for_cache=None,
+    )
+    sched = SimpleNamespace(
+        block_aware_cache=_FakePrefixCache(files),
+        paged_ssd_cache_manager=_FakeManager(),
+        _prefix_cache_prepared=set(),
+        requests={"r1": request},
+        _model_has_unreconstructible_cache=lambda: False,
+    )
+    return sched, request
+
+
+GB = 1024**3
+
+
+class TestPrefetchGate:
+    def test_defers_until_read_done_then_admits(self, monkeypatch, caplog):
+        import threading
+
+        monkeypatch.delenv("OMLX_SSD_PREFETCH", raising=False)
+        gate = threading.Event()
+        _FakeManager.started = gate
+        try:
+            sched, request = _stub([(Path("/x/a"), GB), (Path("/x/b"), GB)])
+            assert Scheduler._should_defer_for_ssd_prefetch(sched, request) is True
+            assert Scheduler._should_defer_for_ssd_prefetch(sched, request) is True
+            assert sched.block_aware_cache.calls == 1
+            gate.set()
+            sched._ssd_prefetch_executor.shutdown(wait=True)
+            with caplog.at_level(logging.INFO, logger="omlx.scheduler"):
+                assert Scheduler._should_defer_for_ssd_prefetch(sched, request) is False
+            assert "SSD prefetch for r1 done: 2/2 blocks" in caplog.text
+            # Done once: later steps admit without a second lookup.
+            assert Scheduler._should_defer_for_ssd_prefetch(sched, request) is False
+            assert sched.block_aware_cache.calls == 1
+        finally:
+            _FakeManager.started = None
+
+    def test_small_prefix_is_not_deferred(self, monkeypatch):
+        monkeypatch.delenv("OMLX_SSD_PREFETCH", raising=False)
+        sched, request = _stub([(Path("/x/a"), 1024)])
+        assert Scheduler._should_defer_for_ssd_prefetch(sched, request) is False
+
+    def test_disabled_by_env(self, monkeypatch):
+        monkeypatch.setenv("OMLX_SSD_PREFETCH", "0")
+        sched, request = _stub([(Path("/x/a"), GB)])
+        assert Scheduler._should_defer_for_ssd_prefetch(sched, request) is False
+        assert sched.block_aware_cache.calls == 0
+
+    def test_prepared_request_is_not_deferred(self, monkeypatch):
+        monkeypatch.delenv("OMLX_SSD_PREFETCH", raising=False)
+        sched, request = _stub([(Path("/x/a"), GB)])
+        sched._prefix_cache_prepared.add("r1")
+        assert Scheduler._should_defer_for_ssd_prefetch(sched, request) is False
+
+    def test_lookup_error_falls_back_to_sync_restore(self, monkeypatch):
+        monkeypatch.delenv("OMLX_SSD_PREFETCH", raising=False)
+        sched, request = _stub([])
+
+        def boom(*_a, **_k):
+            raise RuntimeError("lookup broke")
+
+        sched.block_aware_cache.ssd_prefetch_candidates = boom
+        assert Scheduler._should_defer_for_ssd_prefetch(sched, request) is False
+
+    def test_timeout_admits_request(self, monkeypatch):
+        monkeypatch.delenv("OMLX_SSD_PREFETCH", raising=False)
+        sched, request = _stub([(Path("/x/a"), GB)])
+        never = concurrent.futures.Future()
+        sched._ssd_prefetch_jobs = {"r1": (never, 0.0, 0.0, 1, GB)}
+        assert Scheduler._should_defer_for_ssd_prefetch(sched, request) is False
+
+    def test_jobs_of_gone_requests_are_dropped(self, monkeypatch):
+        monkeypatch.delenv("OMLX_SSD_PREFETCH", raising=False)
+        sched, request = _stub([])
+        never = concurrent.futures.Future()
+        sched._ssd_prefetch_jobs = {"gone": (never, 0.0, 1e18, 1, GB)}
+        Scheduler._should_defer_for_ssd_prefetch(sched, request)
+        assert "gone" not in sched._ssd_prefetch_jobs
