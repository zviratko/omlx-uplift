+    def prefetch_candidates(
+        self, block_hashes: list[bytes]
+    ) -> list[tuple[Path, int]]:
+        """Return (file, size) for the leading blocks that only the SSD holds.
+
+        Blocks in the hot cache or in the pending-write buffer need no disk
+        read and are skipped. The walk stops at the first block the index does
+        not know: reconstruction stops there too. No LRU state is touched.
+        """
+        if self._hot_cache_only or not self._cache_dir:
+            return []
+        out: list[tuple[Path, int]] = []
+        for block_hash in block_hashes:
+            if block_hash is None:
+                break
+            with self._hot_cache_lock:
+                if block_hash in self._hot_cache:
+                    continue
+            with self._pending_write_hashes_lock:
+                if block_hash in self._pending_write_buffers:
+                    continue
+            metadata = self._index.get(block_hash)
+            if metadata is None:
+                break
+            size = int(getattr(metadata, "file_size", 0) or 0)
+            out.append((metadata.file_path, max(0, size)))
+        return out
+
+    @staticmethod
+    def warm_files(
+        files: list[tuple[Path, int]],
+        chunk_bytes: int = 8 * 1024 * 1024,
+    ) -> tuple[int, int]:
+        """Read files once so that the OS page cache holds them.
+
+        Pure file I/O, no MLX/Metal calls: safe on any thread, and the read
+        releases the GIL, so inference continues. The later mx.load() on the
+        inference thread then reads from RAM. A file the OS evicts again in
+        between is simply read from disk as before. Returns (files, bytes).
+        """
+        buf = bytearray(chunk_bytes)
+        view = memoryview(buf)
+        n_files = 0
+        n_bytes = 0
+        for path, _size in files:
+            try:
+                with open(path, "rb", buffering=0) as f:
+                    while True:
+                        got = f.readinto(view)
+                        if not got:
+                            break
+                        n_bytes += got
+                n_files += 1
+            except OSError as exc:
+                logger.debug("SSD prefetch skipped %s: %s", path, exc)
+        return n_files, n_bytes
+
