+    # SSD prefix prefetch: read a waiting request's SSD-only prefix blocks on
+    # a background thread (plain file reads, no MLX) while running requests
+    # keep decoding, then admit it; the restore then reads from page cache.
+    # OMLX_SSD_PREFETCH=0 restores the old synchronous restore.
+    _SSD_PREFETCH_MIN_BYTES = 256 * 1024 * 1024
+    _SSD_PREFETCH_TIMEOUT_S = 600.0
+
+    @staticmethod
+    def _ssd_prefetch_enabled() -> bool:
+        import os
+
+        return os.environ.get("OMLX_SSD_PREFETCH", "1").strip().lower() not in (
+            "0",
+            "false",
+            "no",
+            "off",
+        )
+
+    def _should_defer_for_ssd_prefetch(self, request: Request) -> bool:
+        """Hold the waiting head until its SSD prefix sits in page cache.
+
+        Same contract as _should_defer_for_cache_freshness: never blocks,
+        the step returns and running decode rows continue. Any failure
+        falls back to the normal synchronous restore.
+        """
+        try:
+            return Scheduler._ssd_prefetch_gate(self, request)
+        except Exception as exc:  # noqa: BLE001 - never break admission
+            logger.warning(
+                "SSD prefetch for %s failed, restoring synchronously: %s",
+                getattr(request, "request_id", "?"),
+                exc,
+            )
+            return False
+
+    def _ssd_prefetch_gate(self, request: Request) -> bool:
+        if not Scheduler._ssd_prefetch_enabled():
+            return False
+        if self.block_aware_cache is None:
+            return False
+        manager = getattr(self, "paged_ssd_cache_manager", None)
+        if manager is None or not hasattr(manager, "prefetch_candidates"):
+            return False
+        rid = request.request_id
+        if rid in self._prefix_cache_prepared:
+            return False
+        jobs = self.__dict__.setdefault("_ssd_prefetch_jobs", {})
+        done = self.__dict__.setdefault("_ssd_prefetch_done", set())
+        for stale in [r for r in jobs if r not in self.requests]:
+            jobs.pop(stale, None)
+        done.intersection_update(self.requests.keys())
+
+        job = jobs.get(rid)
+        if job is not None:
+            future, started, deadline, n_files, n_bytes = job
+            now = time.monotonic()
+            if not future.done() and now < deadline:
+                return True
+            jobs.pop(rid, None)
+            done.add(rid)
+            elapsed = max(1e-6, now - started)
+            if future.done() and future.exception() is None:
+                read_files, read_bytes = future.result()
+                logger.info(
+                    "SSD prefetch for %s done: %d/%d blocks, %.2f GB in %.1fs "
+                    "(%.0f MB/s); other requests kept running",
+                    rid,
+                    read_files,
+                    n_files,
+                    read_bytes / 1024**3,
+                    elapsed,
+                    read_bytes / 1024**2 / elapsed,
+                )
+            elif future.done():
+                logger.warning(
+                    "SSD prefetch for %s failed after %.1fs: %s; "
+                    "restoring synchronously",
+                    rid,
+                    elapsed,
+                    future.exception(),
+                )
+            else:
+                logger.warning(
+                    "SSD prefetch for %s still running after %.0fs; "
+                    "restoring synchronously",
+                    rid,
+                    elapsed,
+                )
+            return False
+        if rid in done:
+            return False
+        if self._model_has_unreconstructible_cache():
+            done.add(rid)
+            return False
+
+        files = self.block_aware_cache.ssd_prefetch_candidates(
+            request.prompt_token_ids,
+            extra_keys=request.vlm_extra_keys_for_cache,
+            extra_key_token_start=request.vlm_extra_key_token_start_for_cache,
+            extra_key_ranges=request.vlm_extra_key_ranges_for_cache,
+        )
+        n_bytes = sum(size for _path, size in files)
+        if not files or n_bytes < Scheduler._SSD_PREFETCH_MIN_BYTES:
+            done.add(rid)
+            return False
+
+        executor = self.__dict__.get("_ssd_prefetch_executor")
+        if executor is None:
+            executor = concurrent.futures.ThreadPoolExecutor(
+                max_workers=1, thread_name_prefix="omlx-ssd-prefetch"
+            )
+            self._ssd_prefetch_executor = executor
+        started = time.monotonic()
+        future = executor.submit(type(manager).warm_files, files)
+        jobs[rid] = (
+            future,
+            started,
+            started + Scheduler._SSD_PREFETCH_TIMEOUT_S,
+            len(files),
+            n_bytes,
+        )
+        logger.info(
+            "SSD prefetch for %s started: %d blocks, %.2f GB; the request "
+            "waits, running requests continue",
+            rid,
+            len(files),
+            n_bytes / 1024**3,
+        )
+        return True
+
