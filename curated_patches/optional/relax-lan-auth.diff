diff --git a/omlx/utils/network.py b/omlx/utils/network.py
index 51d8116..bc25ea1 100644
--- a/omlx/utils/network.py
+++ b/omlx/utils/network.py
@@ -138,26 +138,84 @@ def is_loopback_bind(value: str) -> bool:
     )
 
 
+# RFC 1918 private ranges and the RFC 6598 carrier-grade NAT range
+# (used by Tailscale and similar overlay networks). A server bound only to
+# these networks is reachable only from networks the operator already
+# controls, so it is treated like a loopback server for authentication.
+TRUSTED_BIND_NETWORKS = (
+    ipaddress.ip_network("10.0.0.0/8"),
+    ipaddress.ip_network("172.16.0.0/12"),
+    ipaddress.ip_network("192.168.0.0/16"),
+    ipaddress.ip_network("100.64.0.0/10"),
+)
+
+
+def is_trusted_bind_host(value: str) -> bool:
+    """Return whether a bind host is loopback or a private/CGN address.
+
+    Hostnames are never trusted; only literal IP bind hosts qualify.
+    """
+
+    if not isinstance(value, str):
+        return False
+    candidate = value.strip()
+    if not candidate:
+        return False
+    if is_loopback_bind_host(candidate):
+        return True
+    try:
+        address = ipaddress.ip_address(candidate)
+    except ValueError:
+        return False
+    mapped = getattr(address, "ipv4_mapped", None)
+    if mapped is not None:
+        address = mapped
+    return any(address in network for network in TRUSTED_BIND_NETWORKS)
+
+
+def is_trusted_bind(value: str) -> bool:
+    """Return whether every configured bind host is loopback/private/CGN."""
+
+    if not isinstance(value, str):
+        return False
+    bind_hosts = [part.strip() for part in value.split(",") if part.strip()]
+    return bool(bind_hosts) and all(
+        is_trusted_bind_host(part) for part in bind_hosts
+    )
+
+
 def network_auth_error(
     host: str,
     api_key: str | None,
     skip_api_key_verification: bool,
+    skip_all_checks: bool = False,
 ) -> str | None:
-    """Reject unauthenticated servers that bind beyond loopback."""
+    """Reject unauthenticated servers that bind beyond trusted networks.
+
+    ``skip_all_checks`` is the settings.json kill switch
+    (auth.skip_api_key_verification_I_Know_What_I_Am_Doing): when true,
+    every check here is skipped, even on public networks.
+    """
 
     if not isinstance(host, str):
         return "Server host must be a string."
-    if is_loopback_bind(host):
+    if skip_all_checks:
+        return None
+    if is_trusted_bind(host):
         return None
+    _hint = (
+        " If you know what you are doing, there is a very special setting"
+        " in settings.json, but you must find it yourself."
+    )
     if skip_api_key_verification:
         return (
             "API key verification cannot be skipped when binding to a "
-            f"non-loopback host ({host})."
+            f"non-loopback host ({host})." + _hint
         )
     if not isinstance(api_key, str) or not api_key.strip():
         return (
             f"An API key is required when binding to a non-loopback host ({host}). "
-            "Set --api-key or OMLX_API_KEY, or bind to 127.0.0.1."
+            "Set --api-key or OMLX_API_KEY, or bind to 127.0.0.1." + _hint
         )
     return None
 
