+
+
+class TestPoolAwarePressureLevel:
+    """Pooled MLX buffers do not set the pressure level (uplift patch)."""
+
+    @staticmethod
+    def _setup(pool, gb, active_requests=False):
+        enforcer = _make_enforcer(
+            pool, ceiling=100 * gb, soft_threshold=0.85, hard_threshold=0.95
+        )
+        engine = MagicMock()
+        engine.has_active_requests.return_value = active_requests
+        pool._entries = {
+            "model-a": _make_entry("model-a", engine=engine),
+            "model-b": _make_entry("model-b", engine=MagicMock()),
+        }
+        return enforcer, engine
+
+    @pytest.mark.asyncio
+    async def test_pool_pushing_total_over_hard_requests_reclaim_only(
+        self, mock_engine_pool
+    ):
+        gb = 1024**3
+        enforcer, engine = self._setup(mock_engine_pool, gb)
+        with (
+            patch("omlx.process_memory_enforcer.mx") as mock_mx,
+            patch(
+                "omlx.process_memory_enforcer.get_phys_footprint",
+                return_value=97 * gb,
+            ),
+        ):
+            mock_mx.get_active_memory.return_value = 60 * gb
+            mock_mx.get_cache_memory.return_value = 30 * gb
+            await enforcer._check_and_enforce()
+            assert enforcer._pressure_level == "ok"
+            engine.scheduler.request_pressure_reclaim.assert_called_once()
+            mock_engine_pool._unload_engine.assert_not_awaited()
+            # Rate-limited: the next poll does not ask again.
+            await enforcer._check_and_enforce()
+            engine.scheduler.request_pressure_reclaim.assert_called_once()
+
+    @pytest.mark.asyncio
+    async def test_working_memory_over_soft_still_soft(self, mock_engine_pool):
+        gb = 1024**3
+        enforcer, engine = self._setup(mock_engine_pool, gb)
+        with (
+            patch("omlx.process_memory_enforcer.mx") as mock_mx,
+            patch(
+                "omlx.process_memory_enforcer.get_phys_footprint",
+                return_value=92 * gb,
+            ),
+        ):
+            mock_mx.get_active_memory.return_value = 88 * gb
+            mock_mx.get_cache_memory.return_value = 3 * gb
+            await enforcer._check_and_enforce()
+        assert enforcer._pressure_level == "soft"
+
+    def test_stale_executor_sample_keeps_total(self, mock_engine_pool):
+        import time
+
+        gb = 1024**3
+        enforcer, engine = self._setup(mock_engine_pool, gb, active_requests=True)
+        sched = engine.scheduler
+        sched._last_mlx_active_memory_at = time.monotonic() - 60.0
+        enforcer._last_usage_parts = (90 * gb, 60 * gb, 80 * gb, False)
+        assert enforcer._pressure_usage(90 * gb) == (90 * gb, 0)
+        sched._last_mlx_active_memory_at = time.monotonic()
+        assert enforcer._pressure_usage(90 * gb) == (70 * gb, 20 * gb)
+
+    def test_parts_from_another_reading_are_ignored(self, mock_engine_pool):
+        gb = 1024**3
+        enforcer, _engine = self._setup(mock_engine_pool, gb)
+        enforcer._last_usage_parts = (90 * gb, 60 * gb, 80 * gb, True)
+        assert enforcer._pressure_usage(91 * gb) == (91 * gb, 0)
+
+    def test_active_never_reduced_by_pool(self, mock_engine_pool):
+        gb = 1024**3
+        enforcer, _engine = self._setup(mock_engine_pool, gb)
+        # current comes from MLX active (phys smaller): the pool is not in it.
+        enforcer._last_usage_parts = (80 * gb, 80 * gb, 100 * gb, True)
+        assert enforcer._pressure_usage(80 * gb) == (80 * gb, 0)
