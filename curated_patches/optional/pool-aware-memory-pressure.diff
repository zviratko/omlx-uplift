+    def _reclaimable_pool_bytes(self, current: int) -> tuple[int, int]:
+        """Return (MLX active bytes, MLX pool bytes) behind ``current``.
+
+        MLX keeps freed buffers for reuse (cache limit = all of RAM, the #300
+        guard). phys_footprint charges them, but they are not working memory:
+        the pressure reclaim gives them back at the next step boundary.
+        _current_usage_bytes() records the MLX counters it used; they apply
+        only to that same reading, and an executor sample (requests running,
+        the enforcer must not call MLX) only when it is fresh. Returns (0, 0)
+        when unsure, which keeps the old behavior.
+        """
+        parts = getattr(self, "_last_usage_parts", None)
+        if not parts or parts[0] != current:
+            return 0, 0
+        _current, active, mlx_bytes, fresh = parts
+        if not all(isinstance(v, int) for v in (active, mlx_bytes)):
+            return 0, 0
