+
+    def _refresh_mlx_pool_sample(self) -> None:
+        """Re-read MLX active and pool counters on the executor thread.
+
+        Rate-limited to one read per _MLX_POOL_SAMPLE_INTERVAL_S. Both reads
+        are plain allocator counters, so the cost is negligible.
+        """
+        now = time.monotonic()
+        last = getattr(self, "_last_mlx_active_memory_at", 0.0)
+        if not isinstance(last, (int, float)):
+            last = 0.0
+        if now - last < Scheduler._MLX_POOL_SAMPLE_INTERVAL_S:
+            return
+        try:
+            active = int(mx.get_active_memory())
+            cache = int(mx.get_cache_memory())
+        except Exception:
+            return
+        self._last_mlx_active_memory_bytes = max(0, active)
+        self._last_mlx_cache_memory_bytes = max(0, cache)
+        self._last_mlx_active_memory_at = now
+
