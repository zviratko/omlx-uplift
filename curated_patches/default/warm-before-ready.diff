diff --git a/omlx/engine/base.py b/omlx/engine/base.py
index 9058744..085d530 100644
--- a/omlx/engine/base.py
+++ b/omlx/engine/base.py
@@ -368,6 +368,58 @@ class BaseEngine(ABC):
         pass
 
     @abstractmethod
+    async def _warm_before_ready(self, engine_label: str) -> None:
+        """Run one tiny generation through the core before the engine is
+        exposed as loaded.
+
+        The first real request after a load otherwise pays a bundle of
+        once-per-process costs that run on the event loop — chat-template
+        compile, tokenizer first-touch, sampler/collector init, first
+        kernel materialization. Measured: ~0.8 s during which every other
+        loop task (HTTP, streaming, the admin dashboard) stalls, right
+        after the load reported success. Warming here keeps the engine in
+        its loading state while those costs land, so no request ever sees
+        a loaded-but-frozen path; the load button's spinner already covers
+        the extra ~1-3 s.
+
+        Best-effort by design: every failure path logs honestly and leaves
+        the engine usable — a warm failure must never fail the load.
+        """
+        t0 = time.perf_counter()
+        try:
+            render = getattr(self, "_apply_chat_template", None)
+            if callable(render):
+                try:
+                    render([{"role": "user", "content": "warm"}])
+                except Exception as exc:
+                    logger.debug(
+                        f"{engine_label}: warm template pass skipped ({exc!r})"
+                    )
+            core = getattr(self, "_engine", None)
+            if core is None:
+                return
+            from ..request import SamplingParams
+
+            await asyncio.wait_for(
+                core.generate(
+                    "OK",
+                    sampling_params=SamplingParams(
+                        max_tokens=1, temperature=0.0
+                    ),
+                ),
+                timeout=120.0,
+            )
+            logger.info(
+                f"{engine_label}: warmed in "
+                f"{time.perf_counter() - t0:.1f}s"
+            )
+        except Exception as exc:
+            logger.warning(
+                f"{engine_label}: warm failed "
+                f"({type(exc).__name__}: {exc}); engine is usable, the "
+                "first request may carry the one-time costs instead"
+            )
+
     async def stream_generate(
         self,
         prompt: str | list[int],
