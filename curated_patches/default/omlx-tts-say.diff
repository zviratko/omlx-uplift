+    # soundfile ships with the audio extra; lazy import like the array path
+    import soundfile as sf
+
+    fmt = {"mp3": "MP3", "opus": "OGG", "flac": "FLAC"}.get(response_format)
+    if fmt is None:
+        raise ValueError("no streaming encoder for '%s'" % response_format)
